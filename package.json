{
  "name": "n8n-nodes-falkordb-graphrag",
  "version": "1.0.0",
  "description": "n8n community node — wraps the FalkorDB GraphRAG SDK for knowledge-graph ingestion and retrieval.",
  "keywords": [
    "n8n-community-node-package",
    "falkordb",
    "graphrag",
    "knowledge-graph",
    "rag"
  ],
  "license": "MIT",
  "homepage": "https://github.com/FalkorDB/GraphRAG-n8n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FalkorDB/GraphRAG-n8n.git"
  },
  "author": {
    "name": "FalkorDB",
    "email": "support@falkordb.com"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "graphrag_runner.py"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FalkorDbGraphRagApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GraphRag/GraphRag.node.js",
      "dist/nodes/GraphRagAction/GraphRagAction.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.1",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
