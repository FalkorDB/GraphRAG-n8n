{
  "name": "@falkordb/n8n-nodes-graphrag",
  "version": "0.3.0",
  "description": "n8n community node — wraps the FalkorDB GraphRAG-Server REST API for knowledge-graph ingestion and retrieval.",
  "keywords": [
    "n8n-community-node-package",
    "falkordb",
    "graphrag",
    "knowledge-graph",
    "rag"
  ],
  "license": "MIT",
  "homepage": "https://github.com/FalkorDB/GraphRAG-n8n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FalkorDB/GraphRAG-n8n.git"
  },
  "author": {
    "name": "FalkorDB",
    "email": "support@falkordb.com"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "format": "prettier --write \"{nodes,credentials,src,tests}/**/*.ts\" index.ts",
    "format:check": "prettier --check \"{nodes,credentials,src,tests}/**/*.ts\" index.ts",
    "lint": "eslint nodes credentials package.json --ext .ts",
    "lintfix": "eslint nodes credentials package.json --ext .ts --fix",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FalkorDbGraphRagApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GraphRagAction/GraphRagAction.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
